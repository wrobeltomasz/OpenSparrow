# OpenSparrow Environment Configuration
# Copy to .env and fill in your values
# DO NOT COMMIT .env - it contains secrets!
#
# Every variable below is optional unless marked REQUIRED; the value shown is
# the built-in default from includes/config.php. An empty value is treated as
# unset and falls back to that default.

# ---------------------------------------------------------------------------
# Docker Compose only - not read by includes/config.php
# ---------------------------------------------------------------------------
POSTGRES_DB=opensparrow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here-min-32-chars
DOCKER_IMAGE=wrobeltom/opensparrow:latest
HTTP_PORT=80

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# production keeps display_errors off; development turns it on
APP_ENV=production

# Absolute base URL of this installation - used by the {{ app_url }} automation
# placeholder so links in queued e-mails work when generated from CLI/cron.
# Must be an absolute http(s) URL or it is ignored with a log entry
APP_URL=

# Timezone used both by PHP and by the PostgreSQL session (SET TIME ZONE).
# Must be a PHP timezone identifier or it falls back to Europe/Warsaw
APP_TIMEZONE=Europe/Warsaw

# Read-only demo installation - every write action answers 403
DEMO_MODE=false

# Second, independent lock on the installation wizard - set to false once the
# installation is finished. Any value other than true disables setup.php and
# setup_api.php regardless of whether config/database.json exists
SETUP_ENABLED=true

# ---------------------------------------------------------------------------
# Database - DB_* wins, the PG* names are the libpq fallbacks
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=app
# Server-side cap on a single query, in milliseconds, 0 disables it.
# Applied to web requests only - CLI cron, ETL and migrations run unlimited
DB_STATEMENT_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5

# Database TLS - libpq sslmode: disable|allow|prefer|require|verify-ca|verify-full
DB_SSLMODE=prefer
DB_SSLROOTCERT=

# PGHOST / PGPORT / PGDATABASE / PGUSER / PGPASSWORD / PGSCHEMA /
# PGSSLMODE / PGSSLROOTCERT are honoured when the DB_* name is unset
PGSCHEMA=app

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Writable data directory holding sessions/, tmp/, files/, ratelimit/
# Empty means <project root>/storage
STORAGE_PATH=

# Destination of error_log() output. Empty means <STORAGE_PATH>/logs/app.log,
# created with a deny-all .htaccess. Set to a path whose directory is not
# writable and the php.ini destination is kept instead
ERROR_LOG_PATH=

# Override only when sessions or temp files must live outside STORAGE_PATH
SESSION_SAVE_PATH=
SYS_TEMP_DIR=

# ---------------------------------------------------------------------------
# Sessions and cookies
# ---------------------------------------------------------------------------
SECURE_COOKIES=true

# Session cookie name - change it when several apps share one hostname
SESSION_COOKIE_NAME=OSSESSID

# Session cookie path - narrow it to the subdirectory of this installation
# when unrelated apps share the hostname. Must start with /
SESSION_COOKIE_PATH=/

# Lax|Strict|None - None additionally requires SECURE_COOKIES=true
SESSION_SAMESITE=Lax

# Absolute session lifetime in seconds, minimum 60
SESSION_MAX_LIFETIME=28800

# Log out after this many seconds without activity, 0 disables the check
SESSION_IDLE_TIMEOUT=0

# ---------------------------------------------------------------------------
# Secrets - generated into includes/.secret_salt and includes/.secret_key on
# first run when left empty. Set them explicitly when several nodes share one
# database, otherwise each node hashes IPs and encrypts with its own value
# ---------------------------------------------------------------------------
IP_HASH_SALT=
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Password hashing
ARGON2_MEMORY_COST=131072
ARGON2_TIME_COST=4
ARGON2_THREADS=1

PASSWORD_MIN_LENGTH=12

# Login throttling - attempts counted inside the rolling window, then locked out
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_ATTEMPTS_PER_USERNAME=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# HTTP security headers
# ---------------------------------------------------------------------------
# Strict-Transport-Security max-age in seconds, 0 omits the header
HSTS_MAX_AGE=31536000

# Endpoint collecting CSP violation reports - must contain no whitespace,
# semicolon or comma or it is ignored
CSP_REPORT_URI=

# Send the policy as Content-Security-Policy-Report-Only - needs CSP_REPORT_URI
CSP_REPORT_ONLY=false

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Read the client IP from proxy headers instead of REMOTE_ADDR
TRUST_PROXY_HEADERS=false

# Comma-separated IPs/CIDRs allowed to set CF-Connecting-IP / X-Real-IP
# Empty means every client is trusted
TRUSTED_PROXY_IPS=

# Order in which the headers are consulted: cf|x-real-ip|x-forwarded-for
FORWARDED_HEADER_PRIORITY=cf,x-real-ip

# ---------------------------------------------------------------------------
# Files and thumbnails
# ---------------------------------------------------------------------------
FILES_MAX_SIZE_MB=20
FILES_PAGE_LIMIT=25
FILES_PAGE_LIMIT_MAX=100
THUMBNAIL_MAX_WIDTH=300
FILE_CACHE_MAX_AGE=3600
THUMBNAIL_CACHE_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Lists, comments, notifications
# ---------------------------------------------------------------------------
MAX_LIST_ROWS=10000
COMMENTS_PAGE_LIMIT_MAX=50
COMMENTS_MINE_LIMIT=50
NOTIFICATIONS_DROPDOWN_LIMIT=10

# Largest configuration payload accepted by the admin import, in bytes
CONFIG_FILE_MAX_BYTES=524288

# Upper bound for the "older than N days" log purge inputs
ADMIN_PURGE_MAX_DAYS=3650

# Keep a snapshot of every record change
RECORD_SNAPSHOTS_ENABLED=false

# ---------------------------------------------------------------------------
# Outbound e-mail (automations, notifications)
# ---------------------------------------------------------------------------
# Sender address of queued e-mails - falls back to the admin Settings value
AUTOMATION_EMAIL_FROM=
AUTOMATION_EMAIL_BATCH_LIMIT=50
AUTOMATION_EMAIL_MAX_ATTEMPTS=3

# SMTP connect and read timeout in seconds - used by the SMTP delivery path
# and by the admin "Test connection" button
SMTP_TIMEOUT=10

# ---------------------------------------------------------------------------
# Outbound HTTP (webhooks, Ollama)
# ---------------------------------------------------------------------------
HTTP_CLIENT_TIMEOUT=30
HTTP_CLIENT_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
# Authenticated API requests per user per minute, 0 disables the limit
API_RATE_LIMIT_PER_MIN=120

# ---------------------------------------------------------------------------
# AI assistant (Ollama / RAG)
# ---------------------------------------------------------------------------
CHAT_BUBBLE_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
RAG_RATE_LIMIT_PER_MIN=10
RAG_MAX_CONCURRENT=2
RAG_PAGE_CONTEXT_MAX_CHARS=12000
