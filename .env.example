# OpenSparrow Environment Configuration
# Copy to .env and fill in your values
# DO NOT COMMIT .env - it contains secrets!

# Database Configuration
POSTGRES_DB=opensparrow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here-min-32-chars

# PostgreSQL Schema
PGSCHEMA=app

# Docker Image
DOCKER_IMAGE=wrobeltom/opensparrow:latest

# Application Environment
APP_ENV=production
SECURE_COOKIES=true

# Server Port
HTTP_PORT=80

# Sessions
SESSION_IDLE_TIMEOUT=0

# Reverse proxy - comma-separated IPs/CIDRs allowed to set CF-Connecting-IP / X-Real-IP
# Empty means every client is trusted
TRUSTED_PROXY_IPS=

# Outbound HTTP (webhooks, Ollama)
HTTP_CLIENT_TIMEOUT=30
HTTP_CLIENT_CONNECT_TIMEOUT=10

# Password hashing
ARGON2_MEMORY_COST=131072
ARGON2_TIME_COST=4
ARGON2_THREADS=1
